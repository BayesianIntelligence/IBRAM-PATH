<?xml version="1.0" encoding="UTF-8"?>
<smile version="1.0" id="Network1" numsamples="10000" discsamples="10000">
	<nodes>
		<equation id="carrierDailyMortalityRate">
			<definition>carrierDailyMortalityRate=Uniform(0,1)</definition>
			<discretization>
				<interval label="State0" upper="0" />
				<interval label="State1" upper="1" />
			</discretization>
		</equation>
		<equation id="pathogenDailyMortalityRate">
			<definition>pathogenDailyMortalityRate=Uniform(0,1)</definition>
			<discretization>
				<interval label="State0" upper="0" />
				<interval label="State1" upper="1" />
			</discretization>
		</equation>
		<equation id="carrierDailyExitRate">
			<definition>carrierDailyExitRate=Uniform(0,1)</definition>
		</equation>
		<equation id="timeAtSite">
			<definition lower="0" upper="10000000">timeAtSite=Uniform(0,1e+07)</definition>
		</equation>
		<equation id="dailyMortalityRate">
			<parents>carrierDailyMortalityRate pathogenDailyMortalityRate</parents>
			<definition>dailyMortalityRate=1-(1-carrierDailyMortalityRate)*(1-pathogenDailyMortalityRate)</definition>
			<discretization>
				<interval label="State0" upper="0" />
				<interval label="State1" upper="1" />
			</discretization>
		</equation>
		<equation id="exit">
			<parents>carrierDailyExitRate timeAtSite dailyMortalityRate</parents>
			<definition>exit=carrierDailyExitRate*(1-((1-dailyMortalityRate)*(1-carrierDailyExitRate))^timeAtSite)/(1-(1-dailyMortalityRate)*(1-carrierDailyExitRate))</definition>
		</equation>
		<equation id="survive">
			<parents>dailyMortalityRate timeAtSite</parents>
			<definition>survive=(1-dailyMortalityRate)^timeAtSite</definition>
		</equation>
	</nodes>
	<extensions>
