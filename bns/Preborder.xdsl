<?xml version="1.0" encoding="UTF-8"?>
<smile version="1.0" id="Network2" numsamples="1000" discsamples="10000">
	<nodes>
		<equation id="carrierRate">
			<definition lower="0" upper="1">carrierRate=Uniform(0,1)</definition>
		</equation>
		<equation id="detectionRate">
			<definition lower="0" upper="1">detectionRate=Uniform(0,1)</definition>
		</equation>
		<equation id="treatmentEfficacy">
			<definition lower="0" upper="1">treatmentEfficacy=Uniform(0,1)</definition>
		</equation>
		<equation id="treatmentRateForUndetected">
			<definition>treatmentRateForUndetected=Uniform(0,1)</definition>
		</equation>
		<equation id="TR">
			<parents>detectionRate treatmentEfficacy treatmentRateForUndetected</parents>
			<definition lower="0" upper="1">TR=detectionRate*treatmentEfficacy+(1-detectionRate)*treatmentRateForUndetected</definition>
		</equation>
		<equation id="carriersPerUnit">
			<definition lower="0" upper="100">carriersPerUnit=Uniform(0,100)</definition>
		</equation>
		<equation id="units">
			<definition lower="0" upper="100000000000000">units=Uniform(0,10000)</definition>
		</equation>
		<equation id="Carriers">
			<parents>carriersPerUnit units carrierRate TR</parents>
			<definition>Carriers=units*carrierRate*carriersPerUnit*(1-TR)</definition>
		</equation>
		<equation id="infectionRate">
			<definition>infectionRate=Uniform(0,1)</definition>
		</equation>
		<equation id="Infected_Carriers">
			<parents>Carriers infectionRate</parents>
			<definition>Infected_Carriers=Carriers*infectionRate</definition>
		</equation>
	</nodes>
	<extensions>
